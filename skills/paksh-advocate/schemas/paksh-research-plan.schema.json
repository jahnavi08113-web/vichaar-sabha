{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vichaar-sabha/paksh-research-plan",
  "title": "Paksh research plan",
  "type": "object",
  "required": ["mode", "assumptions", "queries"],
  "additionalProperties": false,
  "properties": {
    "mode": { "const": "research_plan" },
    "assumptions": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "required": ["id", "area", "text", "importance", "current_evidence"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^A[1-3]$" },
          "area": { "enum": ["demand", "feasibility", "viability", "risk", "goal_fit"] },
          "text": { "type": "string", "maxLength": 200 },
          "importance": { "enum": ["high", "medium", "low"] },
          "current_evidence": { "enum": ["none", "weak", "medium", "strong"] }
        }
      }
    },
    "queries": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "required": ["id", "assumption", "query", "could_find_against"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q[1-9]$" },
          "assumption": { "type": "string", "pattern": "^A[1-3]$" },
          "query": { "type": "string", "maxLength": 80 },
          "could_find_against": { "type": "boolean" }
        }
      }
    }
  }
}
