{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vichaar-sabha/case-input",
  "title": "Case input",
  "type": "object",
  "required": ["id", "title", "brief", "goal"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "number": { "type": "string" },
    "title": { "type": "string", "maxLength": 120 },
    "brief": { "type": "string", "maxLength": 1200 },
    "goal": { "type": "string", "maxLength": 200 },
    "goal_type": { "enum": ["validate", "build", "earn", "learn", "community"] },
    "exhibits": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "title": { "type": "string" }, "detail": { "type": "string" }, "url": { "type": "string" } }
      }
    }
  }
}
